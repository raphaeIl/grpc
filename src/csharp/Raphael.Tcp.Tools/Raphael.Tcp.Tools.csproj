<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packaging-only project: ships its own protoc, the forked grpc_csharp_plugin
       (TCP variant), the well-known-type proto includes, plus MSBuild
       .props/.targets that drive codegen from the consumer's <Protobuf> items.
       Self-contained: no Grpc.Tools dependency. No compiled output of its own. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: no lib/ref for a build-tooling-only package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>Raphael.Tcp.Tools</PackageId>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>2.0.0 (breaking): self-contained - no longer depends on Grpc.Tools; ships its own protoc, plugin and well-known-type includes, and now generates the C# message classes itself (--csharp_out) alongside the TCP bases. Zero-config default: handler/attr/connection types default to the proto's csharp_namespace (&lt;ns&gt;.IPacketHandler / .PacketHandlerAttribute / .Connection), MsgId members default to the exact message names (no prefix, no CS_/SC_ normalization). Input is read from the consumer's &lt;Protobuf Include=...&gt; items; output goes to the obj/ root by default. TcpMsgIdPrefix now prepends only; CS_/SC_ normalization is opt-in via TcpNormalizeCsScPrefix. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>raphaeIl</Authors>
    <PackageProjectUrl>https://github.com/raphaeIl/grpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/raphaeIl/grpc.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Self-contained protoc tooling that generates synchronous TCP packet-handler
      service bases (IPacketHandler / [PacketHandler(MsgId)] / Connection) plus the C#
      message classes from your .proto files, via a forked grpc_csharp_plugin. Ships its
      own protoc and well-known-type includes; no Grpc.Tools dependency.
      Windows-x64 only in this version.</Description>
    <PackageTags>protobuf;protoc;grpc;tcp;codegen;msbuild</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Ship the MSBuild logic, the bundled protoc + plugin binaries, and the
       well-known-type proto includes as package content. build\** covers both
       the .props/.targets and build\native\include\**. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="tools\**" Pack="true" PackagePath="tools\" />
  </ItemGroup>

</Project>
